; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="MaSzyna World Assets"
config/description="What the worlds share - the terrain atlas, the facades, the plants - edited here and exported as world_assets/<pack>.pck into the game directory"
run/print_header=false
config/use_custom_user_dir=true
config/custom_user_dir_name="MaSzyna-Reloaded"
config/features=PackedStringArray("4.7", "Double Precision", "Forward Plus")
run/flush_stdout_on_print=true

[autoload]

BiomesServer="*res://addons/gnd_biomes/biomes_server.gd"
TrackRenderingServer="*res://addons/libmaszyna/tracks/track_rendering_server.gd"
TractionRenderingServer="*res://addons/libmaszyna/traction/traction_rendering_server.gd"
MaszynaSceneryChunkRenderingServer="*res://addons/libmaszyna/legacy/scenery/maszyna_scenery_chunk_rendering_server.gd"
SmokeSourceLibrary="*res://addons/libmaszyna/smoke/smoke_source_library.gd"
NodebankLibraryBuilder="*uid://dv25nc25tcanw"
Console="*uid://d046w0soh2iou"
MaterialManager="*uid://wsbd7kr83ncg"
MaszynaMaterialParser="*uid://7b48fl428yqa"
MaszynaMaterialFactory="*uid://v144f3irjg7m"
E3DModelManager="*uid://b2v733o52i40x"
MaszynaLegacyVehicleSystem="*res://addons/libmaszyna/legacy/vehicle/maszyna_legacy_vehicle_system.gd"
MaszynaVehicleProfileManager="*res://addons/libmaszyna/legacy/vehicle/maszyna_vehicle_profile_manager.gd"
E3DModelTool="*uid://df7a5f7f35wd1"
AudioStreamManager="*uid://cp8sgfk334adm"
TranscriptSystem="*res://addons/libmaszyna/sound/transcript_system.gd"
TrainSoundSystem="*res://addons/libmaszyna/sound/train_sound_system.gd"
CabinSystem="*res://addons/libmaszyna/cabin/cabin_system.gd"
GndSfxServer="*res://addons/gnd_sfx/gnd_sfx_server.gd"
ScenerySoundServer="*res://addons/libmaszyna/sound/scenery_sound_server.gd"
FIZResourceLoaderRegistrar="*uid://c3g4562u11dp2"
SceneryInstancer="*uid://d33kyubri6utw"

[editor_overrides]

text_editor/behavior/files/trim_trailing_whitespace_on_save=true

[editor_plugins]

enabled=PackedStringArray("res://addons/gnd_biomes/plugin.cfg", "res://addons/gnd_sfx/plugin.cfg", "res://addons/libmaszyna/plugin.cfg", "res://addons/terrain_3d/plugin.cfg", "res://addons/world_assets_export/plugin.cfg")

[maszyna]

locale/translations=PackedStringArray("res://addons/libmaszyna/translations/cz.po", "res://addons/libmaszyna/translations/hu.po", "res://addons/libmaszyna/translations/pl.po", "res://addons/libmaszyna/translations/zh.po")
scenery/shadows/blur=0.4
cabin/shadows/blur=0.4
scenery/track_curve_bake_interval=0.5
weather/fog/volumetric_energy=4.0
scenery/draw_distance=2500.0
weather/fog/curve=2.0
scenery/lights/energy=4.0
scenery/lights/volumetric_fog_energy=6.0
weather/fog/night_distance_factor=6.0
scenery/lights/lamp_attenuation=0.10000000000000002
smoke/generator_mode=1
smoke/dynamic/density=3.0
smoke/static/density=0.5

[physics]

common/physics_ticks_per_second=30
common/max_physics_steps_per_frame=2

[rendering]

textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
textures/default_filters/anisotropic_filtering_level=3
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=96
environment/defaults/default_clear_color=Color(0.05, 0.078, 0.15, 1)
anti_aliasing/quality/use_taa=true

[shader_globals]

maszyna_hdr_output={
"type": "bool",
"value": false
}
maszyna_overcast={
"type": "float",
"value": 0.0
}
maszyna_fog_range={
"type": "float",
"value": 25000.0
}
maszyna_light_level={
"type": "float",
"value": 1.0
}
maszyna_rain_intensity={
"type": "float",
"value": 0.0
}
maszyna_wiper_regen_time={
"type": "float",
"value": 10.0
}
maszyna_wiper_pos={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
maszyna_wiper_since_out={
"type": "vec4",
"value": Vector4(1000, 1000, 1000, 1000)
}
maszyna_wiper_since_return={
"type": "vec4",
"value": Vector4(1000, 1000, 1000, 1000)
}
sky_texture={
"type": "sampler2D",
"value": ""
}
gnd_wind_direction={
"type": "vec2",
"value": Vector2(0.8, 0.3)
}
gnd_wind_speed={
"type": "float",
"value": 1.0
}
gnd_wind_strength={
"type": "float",
"value": 4.0
}
gnd_wind_time={
"type": "float",
"value": 0.0
}
gnd_wind_turbulence={
"type": "float",
"value": 1.0
}
gnd_wind_pattern={
"type": "sampler2D",
"value": "res://world_assets/common_biomes/grass/wind_pattern.png"
}
sgt_legacy_renderer={
"type": "int",
"value": 0
}
sgt_player_position={
"type": "vec3",
"value": Vector3(1000000, 1000000, 1000000)
}
sgt_player_mov={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
sgt_normal_displacement={
"type": "sampler2D",
"value": "res://world_assets/common_biomes/grass/normal.png"
}
sgt_motion_texture={
"type": "sampler2D",
"value": "res://world_assets/common_biomes/grass/motion.png"
}
gnd_high_quality_sky={
"type": "bool",
"value": true
}
gnd_high_quality_foliage={
"type": "bool",
"value": true
}
